<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TaskTrackerDesktop.WinUI.UserControls.RemarkCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTrackerDesktop.WinUI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border 
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16"
        Margin="8">

        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>

            <StackPanel 
                Grid.Row="0"
                Spacing="15" 
                HorizontalAlignment="Left"
                Orientation="Horizontal">

                <Grid Width="30" Height="30" HorizontalAlignment="Center">
                    <Ellipse Fill="{ThemeResource SystemControlBackgroundAccentBrush}"/>
                    <FontIcon 
                        Glyph="&#xE77B;" 
                        FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                        Foreground="White" 
                        FontSize="14"/>

                </Grid>

                <TextBlock Text="{x:Bind RemarkModel.UsersFirstName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="{x:Bind RemarkModel.UsersLastName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"/> 
                <TextBlock 
                    Text="{x:Bind RemarkModel.UsersRole, Mode=OneWay}" 
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"/> 

            </StackPanel>

            <Border 
                Grid.Row="1"
                Height="1" 
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                HorizontalAlignment="Stretch"
                Margin="0,8"/>  

            <ScrollViewer Grid.Row="2">
                <TextBlock 
                    Text="{x:Bind RemarkModel.Text, Mode=OneWay}" 
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"/>  
            </ScrollViewer>

            

        </Grid>
        
    </Border>   
</UserControl>
