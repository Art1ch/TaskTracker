<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskTrackerDesktop.WinUI.Pages.DashboardPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskTrackerDesktop.WinUI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:TaskTrackerDesktop.Core.Models"
    xmlns:userControls="using:TaskTrackerDesktop.WinUI.UserControls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <StackPanel 
            Grid.Row="0" 
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="4">
            <TextBlock 
                Text="Hello, 
                " Style="{ThemeResource BodyStrongTextBlockStyle}"
                FontSize="50"/>
            <TextBlock 
                Text="{x:Bind ViewModel.CurrentUser.FirstName, Mode=OneTime}" 
                Style="{ThemeResource BodyStrongTextBlockStyle}" 
                FontSize="50"/>
            <TextBlock 
                Text="{x:Bind ViewModel.CurrentUser.LastName, Mode=OneTime}" 
                Style="{ThemeResource BodyStrongTextBlockStyle}" 
                FontSize="50"/>
        </StackPanel>
        
        <TextBlock 
            Grid.Row="1"
            HorizontalAlignment="Center"
            Text="Recent Tasks"
            FontSize="30"
            Style="{ThemeResource BaseTextBlockStyle}"/>
        <GridView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.RecentTasksModels, Mode=OneWay}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Stretch">

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="36"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:TaskModel">
                    <userControls:TaskCardView 
                        TaskModel="{x:Bind}"/>
                </DataTemplate>
            </GridView.ItemTemplate>

        </GridView>
    </Grid>
</Page>
